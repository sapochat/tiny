{
  "display_name": "MiniMax H3 Max",
  "job_type": "minimax_h3_max",
  "params": [
    {
      "name": "aspect_ratio",
      "type": "string",
      "default": "auto",
      "required": false,
      "enum": [
        "auto",
        "21:9",
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16"
      ]
    },
    {
      "name": "audio_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "batch_size",
      "type": "integer",
      "default": 1,
      "required": false
    },
    {
      "name": "duration",
      "type": "integer",
      "default": 5,
      "required": false
    },
    {
      "name": "end_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "folder_id",
      "type": "string|null",
      "default": null,
      "required": false
    },
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "prompt",
      "type": "string",
      "default": null,
      "required": true
    },
    {
      "name": "resolution",
      "type": "string",
      "default": "768p",
      "required": false,
      "enum": [
        "480p",
        "768p"
      ]
    },
    {
      "name": "start_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "video_references",
      "type": "array",
      "default": null,
      "required": false
    }
  ],
  "rules": [
    {
      "cel": "params.end_image == null || !(params.start_image == null)",
      "message": "end_image requires start_image"
    },
    {
      "cel": "size(params.image_references) + size(params.video_references) + size(params.audio_references) == 0 || (params.start_image == null && params.end_image == null)",
      "message": "reference media cannot be mixed with start_image or end_image"
    },
    {
      "cel": "size(params.image_references) + size(params.video_references) + size(params.audio_references) <= 12",
      "message": "at most 12 reference media items are allowed in total"
    },
    {
      "cel": "size(params.audio_references) == 0 || size(params.image_references) + size(params.video_references) > 0",
      "message": "reference audio requires a reference image or video"
    }
  ],
  "type": "video"
}
