# Allowlist source, creative inputs, and edit recipes. Generated media stays local.
/*
!/.gitignore
!/README.md
!/BRIEF.md
!/tools/
!/schemas/
!/ref/
!/rounds/
!/picks/

/tools/*
!/tools/*.py
/schemas/*
!/schemas/*.json

/rounds/**
!/rounds/**/
!/rounds/REVIEW-*.md
!/rounds/**/jobs.json

/picks/**
!/picks/chain/
!/picks/chain/chain-v*.json

# Never track private state, caches, logs, or render outputs.
__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.key
*.pem
*.log
*.mp4
*.mov
*.webm
.DS_Store
