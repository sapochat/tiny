# Waveshare ESP32-S3-Touch-AMOLED-1.75C, SKUs 33691/33692.
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# Two 8 MB app slots; see partitions-32mb.csv.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-32mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_AMOLED_175C=y
# The app loop (main task) renders and flushes the display. Wi-Fi and esp_timer are
# pinned to CPU0, so the app runs on CPU1, where nothing outranks it but unpinned tasks.
# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0 is not set
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
